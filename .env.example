# Template for a brand configuration file. Copy it to .env.<brand> (e.g. .env.salesplay)
# and fill in every value — all lines are required; the build stops if one is missing.
# See README.md ("Brand configuration files") for the meaning of each line.

TENANT=salesplay                                  # brand key: salesplay | vendrex | sellmo (matches the file suffix)
TENANT_NAME=SalesPlay                             # brand name as written in the text
TENANT_HOST=salesplaypos.com                      # brand's main web domain
TENANT_API_BASE_URL=https://api.salesplaypos.com/v1.0
TENANT_BACKOFFICE_URL=https://cloud.salesplaypos.com/
TENANT_DEVELOPER_URL=https://developer.salesplay.com
TENANT_SITE_TITLE=SalesPlay Documentation
TENANT_POSTMAN_URL=https://developer.salesplay.com/download_postman_collection.php
TENANT_FAVICON=favicon.ico                        # file name inside static/img/<TENANT_IMG_DIR>/
TENANT_IMG_DIR=salesplay                          # folder under static/img/ with this brand's screenshots
